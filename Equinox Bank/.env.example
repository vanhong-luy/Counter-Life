# =============================================================================
# Equinox Banking System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then start the application:
#   docker compose up --build -d
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Password for the PostgreSQL database user (required).
DB_PASSWORD=change_me_to_a_secure_password

# PostgreSQL username and database name (optional, defaults shown).
POSTGRES_USER=joelchan
POSTGRES_DB=bank

# ---------------------------------------------------------------------------
# JWT Secret
# ---------------------------------------------------------------------------
# Base64-encoded secret key for signing JSON Web Tokens.
# Must be at least 256 bits (32 bytes). Generate one with:
#   openssl rand -base64 32
# Or use any online Base64 generator.
JWT_SECRET=t094gDWCYHH0gJzxzdzrW3EjVRXAbiwNjK5WtdzTgHw=

# ---------------------------------------------------------------------------
# Cloudflare R2 (KYC document storage)
# ---------------------------------------------------------------------------
# Optional — KYC document uploads will fail if not set.
# Get these from your Cloudflare R2 dashboard.
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ---------------------------------------------------------------------------
# CORS Allowed Origins
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to make cross-origin requests.
# For production, set this to your frontend domain (e.g. http://209.97.164.5:3000).
# Defaults to http://localhost:3000 if not set.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend API URLs (for next.config.mjs rewrites)
# ---------------------------------------------------------------------------
# These tell the Next.js server where to proxy API requests.
# In Docker, use the service names. For local dev, use localhost + port.
# ADMIN_API_URL=http://admin-api:8081
# USER_API_URL=http://user-api:8082

# ---------------------------------------------------------------------------
# Default admin credentials (seeded on first run)
# ---------------------------------------------------------------------------
# Email:    admin@equinox.com
# Password: admin
