FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /app

COPY pom.xml mvnw ./
COPY .mvn .mvn
COPY admin-api/pom.xml admin-api/
COPY user-api/pom.xml user-api/

RUN sed -i 's/\r$//' mvnw && chmod +x mvnw

COPY admin-api/src admin-api/src

RUN ./mvnw -pl admin-api package -DskipTests -B

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/admin-api/target/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
